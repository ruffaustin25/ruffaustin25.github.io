<div class="project-container" id="{{{id}}}">
    <div class="project-edge-blur">
        <div class="project-bg-gradient" style="background-image: linear-gradient(180deg, {{{coverGradient.[0]}}}, {{{coverGradient.[1]}}})">
            <div class="project-carousel-container">
                <img class="project-image" src="{{{coverImage}}}">
                <img class="project-image-next" src="{{{coverImage}}}">
            </div>
        </div>
    </div>
    <div class="project-contents">
        <h2>{{{name}}} {{{dateRange}}}</h2>
        <a class="project-link" href={{{linkUrl}}}>{{{linkUrl}}}</a>
        <ul>
{{#each points}}
            <li class="project-point">{{{this.text}}}</li>
    {{#if this.subPoints}}
            <ul>
        {{#each this.subPoints}}
                <li class="project-subpoint">{{{this}}}</li>
        {{/each}}
            </ul>
    {{/if}}
{{/each}}
        </ul>
    </div>
</div>